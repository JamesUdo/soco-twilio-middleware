# ========================================
# SOCO PRODUCTION - Twilio Middleware Config
# ========================================
# Copy this file to .env and fill in your values

# Twilio Credentials (from https://console.twilio.com)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# Base44 API
BASE44_APP_ID=6991071af68812a959821948
BASE44_API_URL=https://avlproj.base44.app/api/apps/6991071af68812a959821948
BASE44_API_KEY=your_base44_api_key_here

# Server
PORT=3000
BASE_URL=https://your-deployed-url.com

# Optional: Voicemail transcription language
VOICEMAIL_LANGUAGE=en-US

# DocuSign Integration (JWT Grant flow)
DOCUSIGN_ACCOUNT_ID=6a354328-b2bf-460f-a142-643485c99856
DOCUSIGN_INTEGRATION_KEY=your_integration_key_here
DOCUSIGN_USER_ID=46e327da-fe7b-4fa6-996b-8123e27aed16
DOCUSIGN_PRIVATE_KEY=your_rsa_private_key_here
DOCUSIGN_BASE_URL=https://na4.docusign.net
DOCUSIGN_AUTH_SERVER=account.docusign.com
